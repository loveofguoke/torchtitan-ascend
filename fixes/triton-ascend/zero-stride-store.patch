-    const int64_t resultDim = resultType.getShape()[i];
-    if (srcDim == 1 && resultDim != 1) {
-      ++broadcastedDims;
-      continue;
-    }
-    if (srcDim != resultDim)
-      return false;
-  }
-  if (broadcastedDims != 1)
-    return false;
-
-  Value source = broadcast.getSrc();
-  while (auto addPtr = source.getDefiningOp<triton::AddPtrOp>())
