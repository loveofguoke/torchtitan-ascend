@@ -1,6 +1,25 @@
 from torch_npu._init.patches.patch_manager import PatchManager
 
 
+@PatchManager.register_patch("npu")
+def apply_storage_factory_patch():
+    from functools import wraps
+
+    import torch
+    import torch_npu
+
+    original = torch._C._construct_storage_from_data_pointer
+
+    @wraps(original)
+    def construct_storage(data_ptr, device, size_bytes):
+        device = torch.device(device)
+        if device.type == "npu":
+            return torch_npu._C._construct_storage_from_data_pointer(data_ptr, device, size_bytes)
+        return original(data_ptr, device, size_bytes)
+
+    torch._C._construct_storage_from_data_pointer = construct_storage
+
+
 @PatchManager.register_patch("npu")
