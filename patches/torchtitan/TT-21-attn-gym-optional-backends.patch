Subject: [PATCH] Allow Attention Gym imports without optional backends
Applies-To: 6f22255756ca247f343f2f517671c61f0a407e9b
---
diff --git a/torchtitan/models/common/attn_gym.py b/torchtitan/models/common/attn_gym.py
index 7cf01d8..415e572 100644
--- a/torchtitan/models/common/attn_gym.py
+++ b/torchtitan/models/common/attn_gym.py
@@ -146,8 +146,20 @@ def _load_module(name: str) -> ModuleType | None:
 def __getattr__(name: str) -> Any:
     if name not in _EXPORTS:
         raise AttributeError(f"module {__name__!r} has no attribute {name!r}")
-    module = _load_module(_EXPORTS[name])
-    value = _MissingKernel if module is None else getattr(module, name)
+    try:
+        module = _load_module(_EXPORTS[name])
+        value = _MissingKernel if module is None else getattr(module, name)
+    except ImportError as error:
+        cause = error
+        while isinstance(cause.__cause__, ImportError):
+            cause = cause.__cause__
+        if (
+            not isinstance(cause, ModuleNotFoundError)
+            or cause.name is None
+            or cause.name.split(".")[0] == "attn_gym"
+        ):
+            raise
+        value = _MissingKernel
     globals()[name] = value
     return value
 
